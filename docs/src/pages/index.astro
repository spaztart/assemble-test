---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Assemble - Design System" description="A comprehensive design system for building consistent, accessible, and beautiful user interfaces.">
  <div class="home">
    <section class="hero">
      <div class="hero-content">
        <p class="hero-label">McAfee's Design System</p>
        <h1 class="hero-title">
          <span class="title-main">Assemble</span>
        </h1>
        <div class="hero-powered">
          <p class="powered-text">powered by<br><strong>Material 3 using Flutter framework</strong></p>
          <p class="powered-text">powered by<br><strong>Material 3 using Flutter framework</strong></p>
          <p class="powered-text">powered by<br><strong>Material 3 using Flutter framework</strong></p>
        </div>
      </div>
    </section>
    <canvas id="threejs-canvas" class="hero-canvas"></canvas>
  </div>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { LineSegments2 } from 'three/addons/lines/LineSegments2.js';
  import { LineSegmentsGeometry } from 'three/addons/lines/LineSegmentsGeometry.js';
  import { LineMaterial } from 'three/addons/lines/LineMaterial.js';

  function initScene() {
    const canvas = document.getElementById('threejs-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    // --- Read design tokens from CSS custom properties ---
    // Use canvas pixel sampling — works with oklch, color(), rgb, hex, etc.
    const probeCanvas = document.createElement('canvas');
    probeCanvas.width = 1;
    probeCanvas.height = 1;
    const probeCtx = probeCanvas.getContext('2d', { willReadFrequently: true })!;

    function cssColorToHex(varName: string, fallback: number): number {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
      if (!raw) return fallback;
      probeCtx.clearRect(0, 0, 1, 1);
      probeCtx.fillStyle = '#000';  // reset
      probeCtx.fillStyle = raw;
      probeCtx.fillRect(0, 0, 1, 1);
      const [r, g, b] = probeCtx.getImageData(0, 0, 1, 1).data;
      return (r << 16) | (g << 8) | b;
    }

    function cssColorToCSS(varName: string, fallback: string): string {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
      if (!raw) return fallback;
      // Canvas2D gradients accept oklch() and all modern CSS color formats directly
      return raw;
    }

    function readTokens() {
      return {
        primaryColor: cssColorToHex('--md-sys-color-primary', 0x5B1A8E),
        surfaceColor: cssColorToHex('--md-sys-color-surface', 0xffffff),
        mcafeeContainerColor: cssColorToHex('--md-sys-color-tertiary-container', 0xB082D2),
      };
    }

    let tokens = readTokens();

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setClearColor(0x000000, 0);
    const scene = new THREE.Scene();

    function makeCamera(w: number, h: number) {
      const a = w / h, f = 6;
      const cam = new THREE.OrthographicCamera(-f * a, f * a, f, -f, 0.1, 200);
      cam.position.set(20, 30, 20);
      cam.lookAt(0, 0, 0);
      return cam;
    }

    let camera = makeCamera(canvas.clientWidth || 600, canvas.clientHeight || 580);

    const gap = 1.5, sz = 1.0;
    const NX = 3, NY = 4, NZ = 3, N = NX * NY * NZ;
    const LIFT = 0.18;
    const pivot = new THREE.Group();
    pivot.position.set(6, 4, 0);
    scene.add(pivot);

    // Solid color material for middle blocks
    let mcafeeMat: THREE.MeshBasicMaterial;

    const geo = new THREE.BoxGeometry(sz, sz, sz);
    const edgeGeo = new THREE.EdgesGeometry(geo);

    // Build fat-line geometry from EdgesGeometry
    function edgesToLineGeo(edges: THREE.EdgesGeometry): LineSegmentsGeometry {
      const pos = edges.getAttribute('position');
      const arr: number[] = [];
      for (let i = 0; i < pos.count; i++) {
        arr.push(pos.getX(i), pos.getY(i), pos.getZ(i));
      }
      const lineGeo = new LineSegmentsGeometry();
      lineGeo.setPositions(arr);
      return lineGeo;
    }

    const cubeLineGeo = edgesToLineGeo(edgeGeo);

    // LineMaterial for thick outlines — uses md-sys-color-primary
    const LINE_WIDTH = 2.5;
    const outlineMat = new LineMaterial({
      color: tokens.primaryColor,
      linewidth: LINE_WIDTH,
      worldUnits: false,
      dashed: false,
    });
    outlineMat.resolution.set(canvas.clientWidth || 600, canvas.clientHeight || 580);

    const meshes: THREE.Mesh[] = [], lines: LineSegments2[] = [];
    const surfaceMats: THREE.MeshBasicMaterial[] = [];

    // Create mcafee container material
    mcafeeMat = new THREE.MeshBasicMaterial({ color: tokens.mcafeeContainerColor });

    for (let x = 0; x < NX; x++) for (let y = 0; y < NY; y++) for (let z = 0; z < NZ; z++) {
      const isMid = (y === 1 || y === 2);
      let mat: THREE.MeshBasicMaterial;
      if (isMid) {
        mat = mcafeeMat;
      } else {
        mat = new THREE.MeshBasicMaterial({ color: tokens.surfaceColor });
        surfaceMats.push(mat);
      }
      const m = new THREE.Mesh(geo, mat);
      pivot.add(m); meshes.push(m);
      
      const l = new LineSegments2(cubeLineGeo, outlineMat);
      l.computeLineDistances();
      pivot.add(l); lines.push(l);
    }

    // Platform
    const platW = (NX - 1) * gap + sz + 1.6, platD = (NZ - 1) * gap + sz + 1.6, platH = 0.22;
    const platGeo = new THREE.BoxGeometry(platW, platH, platD);
    const yS = -((NY - 1) / 2) * gap;
    const platY = yS - sz * 0.5 - LIFT - platH * 0.5;
    const platSurfaceMat = new THREE.MeshBasicMaterial({ color: tokens.surfaceColor });
    const platM = new THREE.Mesh(platGeo, platSurfaceMat);
    platM.position.set(0, platY, 0); pivot.add(platM);
    const platLineGeo = edgesToLineGeo(new THREE.EdgesGeometry(platGeo));
    const platE = new LineSegments2(platLineGeo, outlineMat);
    platE.computeLineDistances();
    platE.position.copy(platM.position); pivot.add(platE);

    // --- Re-apply tokens to all materials when theme changes ---
    function updateThemeColors() {
      tokens = readTokens();

      // Update outline color
      outlineMat.color.setHex(tokens.primaryColor);

      // Update surface (white) cube materials
      surfaceMats.forEach(mat => mat.color.setHex(tokens.surfaceColor));

      // Update platform material
      platSurfaceMat.color.setHex(tokens.surfaceColor);

      // Update mcafee container color
      mcafeeMat.color.setHex(tokens.mcafeeContainerColor);
    }

    // Watch for data-theme changes on <html>
    const themeObserver = new MutationObserver(() => {
      // Defer to next frame so the browser has recalculated styles for the new theme
      requestAnimationFrame(() => updateThemeColors());
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    const raycaster = new THREE.Raycaster();

    function gridPositions() {
      const p: THREE.Vector3[] = [], xS = -((NX - 1) / 2) * gap, zS = -((NZ - 1) / 2) * gap;
      for (let x = 0; x < NX; x++) for (let y = 0; y < NY; y++) for (let z = 0; z < NZ; z++)
        p.push(new THREE.Vector3(xS + x * gap, yS + y * gap, zS + z * gap));
      return p;
    }

    function pad(arr: THREE.Vector3[]) {
      const last = arr[arr.length - 1].clone();
      while (arr.length < N) arr.push(last.clone());
      return arr;
    }

    function g(x: number, y: number, z: number) {
      return new THREE.Vector3(x * gap, y * gap, z * gap);
    }

    const shapes = [
      gridPositions(),
      pad([
        g(-1, 1.5, -1), g(0, 1.5, -1), g(1, 1.5, -1), g(-1, 1.5, 0), g(0, 1.5, 0), g(1, 1.5, 0), g(-1, 1.5, 1), g(0, 1.5, 1), g(1, 1.5, 1),
        g(-1, 0.5, -1), g(-1, -0.5, -1), g(-1, -1.5, -1), g(1, 0.5, -1), g(1, -0.5, -1), g(1, -1.5, -1),
        g(-1, 0.5, 1), g(-1, -0.5, 1), g(-1, -1.5, 1), g(1, 0.5, 1), g(1, -0.5, 1), g(1, -1.5, 1),
      ]),
      pad([g(-1, 1.5, 0), g(-1, 0.5, 0), g(-1, -0.5, 0), g(-1, -1.5, 0), g(0, -1.5, 0), g(1, -1.5, 0)]),
      pad([g(-1, 1.5, 0), g(0, 1.5, 0), g(1, 1.5, 0), g(0, 0.5, 0), g(0, -0.5, 0), g(0, -1.5, 0)]),
      pad([g(-1, 1.5, 0), g(-1, 0.5, 0), g(-1, -0.5, 0), g(-1, -1.5, 0), g(0, -0.5, 0), g(0, 0.5, 0), g(1, 1.5, 0), g(1, 0.5, 0), g(1, -0.5, 0), g(1, -1.5, 0)]),
      pad([g(-1, 1.5, 0), g(0, 1.5, 0), g(1, 1.5, 0), g(0, 0.5, 0), g(0, -0.5, 0), g(-1, -1.5, 0), g(0, -1.5, 0), g(1, -1.5, 0)]),
      pad([
        g(-1, -1.5, -1), g(-1, -1.5, 0), g(-1, -1.5, 1),
        g(0, -1.5, -1), g(0, -0.5, -1), g(0, -1.5, 0), g(0, -0.5, 0), g(0, -1.5, 1), g(0, -0.5, 1),
        g(1, -1.5, -1), g(1, -0.5, -1), g(1, 0.5, -1), g(1, -1.5, 0), g(1, -0.5, 0), g(1, 0.5, 0), g(1, -1.5, 1), g(1, -0.5, 1), g(1, 0.5, 1),
      ]),
      pad([g(-1, -1.5, 0), g(-1, -0.5, 0), g(-1, 0.5, 0), g(-1, 1.5, 0), g(0, 1.5, 0), g(1, -1.5, 0), g(1, -0.5, 0), g(1, 0.5, 0), g(1, 1.5, 0)]),
      pad([
        g(-1, -1.5, -1), g(0, -1.5, -1), g(1, -1.5, -1), g(-1, -1.5, 0), g(0, -1.5, 0), g(1, -1.5, 0), g(-1, -1.5, 1), g(0, -1.5, 1), g(1, -1.5, 1),
        g(-1, -0.5, -1), g(1, -0.5, -1), g(-1, -0.5, 1), g(1, -0.5, 1),
        g(-1, 0.5, 0), g(1, 0.5, 0), g(0, 0.5, -1), g(0, 0.5, 1), g(0, 1.5, 0),
      ]),
      pad([g(0, 1.5, 0), g(0, 0.5, 0), g(0, -0.5, 0), g(0, -1.5, 0), g(-1, -0.5, 0), g(1, -0.5, 0), g(0, -0.5, -1), g(0, -0.5, 1)]),
    ];

    const shapeNames = ['3×4×3', 'table', 'letter L', 'letter T', 'letter H', 'letter I', 'staircase', 'arch', 'pyramid', 'cross'];
    let currentIdx = 0;
    let targets = gridPositions();
    meshes.forEach((m, i) => { m.position.copy(targets[i]); lines[i].position.copy(m.position); });

    // Physics system for explosive dispersion with rotation and collisions
    const velocities: THREE.Vector3[] = meshes.map(() => new THREE.Vector3());
    const angularVelocities: THREE.Vector3[] = meshes.map(() => new THREE.Vector3());
    const rotations: THREE.Euler[] = meshes.map(() => new THREE.Euler());
    const returnDelays: number[] = meshes.map((_, i) => i * 100); // Stagger return timing
    let isDispersed = false;
    let disperseStartTime = 0;
    const SETTLE_DURATION = 5000; // 5 seconds before returning
    const GRAVITY = 0.002; // Very light gravity for floaty feel
    const BOUNCE_DAMPING = 0.7; // Energy loss on bounce
    const AIR_RESISTANCE = 0.99; // Air resistance
    const ANGULAR_DAMPING = 0.98; // Rotation slowdown
    const COLLISION_RADIUS = 0.7; // Collision detection radius
    const COLLISION_DAMPING = 0.4; // Lower collision power
    
    // Boundaries based on hero container (viewport-relative)
    const BOUNDS = { x: 14, y: 12, z: 10 };

    // Track which cubes should be visible to avoid overlaps
    function updateVisibility() {
      const OVERLAP_THRESHOLD = 0.3;
      const positionMap = new Map<string, number>();
      
      // Find which cubes are at each position
      targets.forEach((target, i) => {
        const key = `${target.x.toFixed(1)},${target.y.toFixed(1)},${target.z.toFixed(1)}`;
        if (!positionMap.has(key)) {
          positionMap.set(key, i);
        }
      });
      
      // Set visibility - only show one cube per position
      meshes.forEach((m, i) => {
        const key = `${targets[i].x.toFixed(1)},${targets[i].y.toFixed(1)},${targets[i].z.toFixed(1)}`;
        const firstIndex = positionMap.get(key);
        m.visible = (firstIndex === i);
        lines[i].visible = (firstIndex === i);
      });
    }

    function disperse() {
      isDispersed = true;
      disperseStartTime = Date.now();
      meshes.forEach((m, i) => {
        // Explosion force - strong enough to scatter
        const angle = Math.random() * Math.PI * 2;
        const force = 0.4 + Math.random() * 0.5;
        velocities[i].set(
          Math.cos(angle) * force,
          Math.random() * 0.5 + 0.3, // Strong upward component
          Math.sin(angle) * force
        );
        
        // Random angular velocity for tumbling rotation
        angularVelocities[i].set(
          (Math.random() - 0.5) * 0.25,
          (Math.random() - 0.5) * 0.25,
          (Math.random() - 0.5) * 0.25
        );
        
        // Reset rotation
        rotations[i].set(0, 0, 0);
      });
    }

    function updatePhysics() {
      if (!isDispersed) return;

      const elapsed = Date.now() - disperseStartTime;

      let allSettled = true;
      
      // Update physics for each cube
      meshes.forEach((m, i) => {
        const vel = velocities[i];
        const angVel = angularVelocities[i];
        const pos = m.position;
        const rot = rotations[i];
        
        // Check if this cube should start returning (staggered timing)
        const cubeReturnTime = SETTLE_DURATION + returnDelays[i];
        const shouldReturn = elapsed > cubeReturnTime;
        
        if (!shouldReturn) {
          // Still in explosion/floating phase
          // Apply very light gravity
          vel.y -= GRAVITY;
          
          // Apply air resistance
          vel.multiplyScalar(AIR_RESISTANCE);
          angVel.multiplyScalar(ANGULAR_DAMPING);
          
          // Apply velocity
          pos.add(vel);
          
          // Apply angular velocity (rotation)
          rot.x += angVel.x;
          rot.y += angVel.y;
          rot.z += angVel.z;
          m.rotation.copy(rot);
          
          // Platform floor collision - simple Y boundary
          const floorY = platY + platH * 0.5 + sz * 0.5;
          if (pos.y < floorY) {
            pos.y = floorY;
            vel.y *= -BOUNCE_DAMPING;
            angVel.x += (Math.random() - 0.5) * 0.1;
          }
          
          // Bounce off boundaries - keep cubes inside hero container
          if (pos.x < -BOUNDS.x || pos.x > BOUNDS.x) {
            pos.x = Math.max(-BOUNDS.x, Math.min(BOUNDS.x, pos.x));
            vel.x *= -BOUNCE_DAMPING;
            angVel.y += vel.x * 0.1; // Add spin from bounce
          }
          if (pos.y < -BOUNDS.y || pos.y > BOUNDS.y) {
            pos.y = Math.max(-BOUNDS.y, Math.min(BOUNDS.y, pos.y));
            vel.y *= -BOUNCE_DAMPING;
            angVel.x += vel.y * 0.1;
          }
          if (pos.z < -BOUNDS.z || pos.z > BOUNDS.z) {
            pos.z = Math.max(-BOUNDS.z, Math.min(BOUNDS.z, pos.z));
            vel.z *= -BOUNCE_DAMPING;
            angVel.x += vel.z * 0.1;
          }
          
          allSettled = false;
        } else {
          // Return phase - smooth lerp back to position
          const distToTarget = pos.distanceTo(targets[i]);
          
          if (distToTarget > 0.05) {
            // Smoothly lerp position back
            pos.lerp(targets[i], 0.05);
            
            // Gradually reset rotation
            rot.x *= 0.92;
            rot.y *= 0.92;
            rot.z *= 0.92;
            m.rotation.copy(rot);
            
            allSettled = false;
          } else {
            // Snap to final position
            pos.copy(targets[i]);
            rot.set(0, 0, 0);
            m.rotation.set(0, 0, 0);
          }
        }
        
        lines[i].position.copy(pos);
        lines[i].rotation.copy(rot);
      });
      
      // Cube-to-cube collision detection (only during explosion phase)
      if (elapsed < SETTLE_DURATION) {
        for (let i = 0; i < meshes.length; i++) {
          for (let j = i + 1; j < meshes.length; j++) {
            const pos1 = meshes[i].position;
            const pos2 = meshes[j].position;
            const dist = pos1.distanceTo(pos2);
            
            if (dist < COLLISION_RADIUS) {
              // Collision detected - calculate collision response
              const normal = new THREE.Vector3().subVectors(pos2, pos1).normalize();
              const relativeVel = new THREE.Vector3().subVectors(velocities[j], velocities[i]);
              const velAlongNormal = relativeVel.dot(normal);
              
              // Only resolve if cubes are moving toward each other
              if (velAlongNormal < 0) {
                const impulse = normal.multiplyScalar(velAlongNormal * COLLISION_DAMPING);
                velocities[i].add(impulse);
                velocities[j].sub(impulse);
                
                // Add rotational impulse from collision (reduced power)
                angularVelocities[i].add(new THREE.Vector3(
                  (Math.random() - 0.5) * 0.05,
                  (Math.random() - 0.5) * 0.05,
                  (Math.random() - 0.5) * 0.05
                ));
                angularVelocities[j].add(new THREE.Vector3(
                  (Math.random() - 0.5) * 0.05,
                  (Math.random() - 0.5) * 0.05,
                  (Math.random() - 0.5) * 0.05
                ));
                
                // Separate cubes to prevent overlap
                const separation = (COLLISION_RADIUS - dist) / 2;
                pos1.add(normal.clone().multiplyScalar(-separation));
                pos2.add(normal.clone().multiplyScalar(separation));
              }
            }
          }
        }
      }

      // Reset when all cubes have settled
      if (allSettled) {
        isDispersed = false;
        meshes.forEach((m, i) => {
          m.position.copy(targets[i]);
          m.rotation.set(0, 0, 0);
          velocities[i].set(0, 0, 0);
          angularVelocities[i].set(0, 0, 0);
          rotations[i].set(0, 0, 0);
          lines[i].position.copy(targets[i]);
          lines[i].rotation.set(0, 0, 0);
        });
      }
    }

    let lastTap = 0;
    function morph() {
      if (isDispersed) return; // Don't morph during dispersion
      let next: number;
      do { next = Math.floor(Math.random() * shapes.length); } while (next === currentIdx);
      currentIdx = next;
      targets = shapes[currentIdx];
      updateVisibility();
    }

    function getPointerNDC(e: MouseEvent | TouchEvent, isTouch: boolean) {
      const rect = canvas.getBoundingClientRect();
      const cx = isTouch ? (e as TouchEvent).changedTouches[0].clientX : (e as MouseEvent).clientX;
      const cy = isTouch ? (e as TouchEvent).changedTouches[0].clientY : (e as MouseEvent).clientY;
      return new THREE.Vector2(
        ((cx - rect.left) / rect.width) * 2 - 1,
        -((cy - rect.top) / rect.height) * 2 + 1
      );
    }

    function handleClick(ndc: THREE.Vector2) {
      raycaster.setFromCamera(ndc, camera);
      const hits = raycaster.intersectObjects(meshes);
      if (hits.length > 0) disperse();
    }

    // Auto-morph every 3.5 seconds
    setInterval(() => {
      morph();
    }, 3500);

    // Also allow manual morphing by clicking
    canvas.addEventListener('click', (e) => handleClick(getPointerNDC(e, false)));
    canvas.addEventListener('touchend', (e) => {
      const now = Date.now();
      if (now - lastTap < 300) { e.preventDefault(); return; }
      lastTap = now;
      handleClick(getPointerNDC(e, true));
    }, { passive: false });

    function resize() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      if (renderer.domElement.width !== w || renderer.domElement.height !== h) {
        renderer.setSize(w, h, false);
        const a = w / h, f = 4;
        camera.left = -f * a; camera.right = f * a; camera.top = f; camera.bottom = -f;
        camera.updateProjectionMatrix();
      }
      // Keep LineMaterial resolution in sync with canvas size
      outlineMat.resolution.set(w, h);
    }

    function animate() {
      requestAnimationFrame(animate);
      
      // Only rotate platform when not dispersed
      if (!isDispersed) {
        pivot.rotation.y += 0.002;
      }
      
      if (isDispersed) {
        updatePhysics();
      } else {
        meshes.forEach((m, i) => { m.position.lerp(targets[i], 0.08); lines[i].position.copy(m.position); });
      }
      
      resize();
      renderer.render(scene, camera);
    }
    animate();
  }

  // Initialize on page load and after view transitions
  initScene();
  document.addEventListener('astro:after-swap', initScene);
</script>

<style>
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    min-height: calc(100vh - 52px);
    padding: 48px 32px;
    background-image: 
      linear-gradient(to right, color-mix(in srgb, var(--md-sys-color-outline-variant) 25%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--md-sys-color-outline-variant) 25%, transparent) 1px, transparent 1px);
    background-size: 96px 96px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width:100%;
  }

  .hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    cursor: pointer;
  }

  .hero-label {
    font-size: 32px;
    font-weight: 400;
    padding: 0 16px;
    color: var(--md-sys-color-on-surface);
    letter-spacing: 0.5px;
  }

  .hero-title {
    font-family: 'McAfee Sans', system-ui, sans-serif;
    font-size: 120px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -3px;
    display: flex;
    align-items: baseline;
    gap: 24px;
  }

  .title-main {
    color: var(--md-sys-color-on-surface);
  }

  .title-version {
    background: linear-gradient(135deg, 
      var(--md-sys-color-primary) 0%,
      var(--md-sys-color-tertiary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-powered {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .powered-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0;
  }

  .powered-text strong {
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
  }

  @media (max-width: 1024px) {
    .hero-content {
      max-width: 60%;
    }

    .hero-title {
      font-size: 80px;
      letter-spacing: -2px;
    }

