      "md.ref.type.font.*",
      "md.type.size.*"
    ],
    "architecture": [
      "key (md.key.*)",
      "reference (md.ref.*)",
      "semantic (md.sys.* / mcafee.*)"
    ],
    "builds": {
      "$comment": "One token source, two builds. Both bindings consume the same semantic layer, so there is no mapping to declare between them.",
      "flutter": {
        "package": "assemble_flutter_tokens",
        "consumed_by": "the Flutter binding"
      },
      "web": {
        "package": "the web token build — read it from the web token package",
        "form": "CSS custom properties, a JS export, or both",
        "consumed_by": "the React binding",
        "token_names_carry_across": true,
        "naming_transform": "mechanical, and NOT recorded in these docs. Read it from the web token package once, confirm it, use it everywhere. Never guess it, and never fall back to a literal because you could not find the variable.",
        "missing_token": "a gap in the web build to report — never licence to inline a value"
      }
    },
    "flutter_accessors": [
      "asmColorScheme(brightness:)",
      "AsmTokens.of(context)",
      "context.asmTokens",
      "context.asmExtendedColors",
      "context.asmStateColors",
      "context.asmGradients",
      "context.asmTokens.shadows",
      "AsmSpacing.*"
    ]
  },
