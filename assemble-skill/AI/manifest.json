  "accessibility_floor": [
    {
      "id": "a11y-1",
      "rule": "48x48 minimum touch target, via padding, holding at 200% text scale"
    },
    {
      "id": "a11y-2",
      "rule": "visible keyboard focus ring: md.sys.color.primary, 2px, 2px offset"
    },
    {
      "id": "a11y-3",
      "rule": "never convey meaning by colour alone"
    },
    {
      "id": "a11y-4",
      "rule": "every meaningful icon has an accessible name; decorative icons are hidden"
    },
    {
      "id": "a11y-5",
      "rule": "icon-only controls need both an accessible label and a tooltip"
    },
    {
      "id": "a11y-6",
      "rule": "contrast: 4.5:1 normal text, 3:1 large text, 3:1 interactive and non-text"
    },
    {
      "id": "a11y-7",
      "rule": "nothing consequential lives only in a transient or hover-only surface"
    },
    {
      "id": "a11y-8",
      "rule": "disabled elements leave the tab order and receive no other state"
    }
  ],
  "accessibility_documented_exceptions": [
    {
      "case": "disabled content at 38% opacity",
      "why_accepted": "non-interactive; therefore disabled text may never be the only place information appears"
    },
    {
      "case": "Cards 'brand' variant at 3.9:1",
      "why_accepted": "large text only; not a licence to relax contrast elsewhere"
    }
  ],
